# Lokal mit Ollama (Standard)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
CHAT_MODEL=llama3.1
EMBED_MODEL=nomic-embed-text

# Beispiel Cloud (OpenAI):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# CHAT_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small
# Achtung: Nach Wechsel des Embedding-Modells "python ingest.py --reset" ausführen!

CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=4

# Erlaubte Origins für CORS (kommagetrennt)
CORS_ORIGINS=http://localhost:5173

# Ollama auf dem Windows-Host, Backend in WSL2 (NAT-Modus): Host-IP statt localhost,
# siehe README, Abschnitt "Ollama unter Windows, Backend in WSL"
# LLM_BASE_URL=http://172.20.80.1:11434/v1
